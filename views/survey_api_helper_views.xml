<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Survey API Helper Tree View -->
    <record id="view_survey_api_tree" model="ir.ui.view">
        <field name="name">survey.survey.api.tree</field>
        <field name="model">survey.survey</field>
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="title"/>
                <field name="active"/>
                <field name="api_submit_endpoint"/>
            </list>
        </field>
    </record>

    <!-- Survey API Helper Form View -->
    <record id="view_survey_api_form" model="ir.ui.view">
        <field name="name">survey.survey.api.form</field>
        <field name="model">survey.survey</field>
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <h1>
                        <field name="title"/>
                    </h1>
                    <group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="API Endpoints">
                        <group>
                            <field name="api_submit_endpoint" widget="url"/>
                            <field name="api_update_endpoint" widget="url"/>
                        </group>
                        <group>
                            <field name="api_info_endpoint" widget="url"/>
                            <field name="api_participations_endpoint" widget="url"/>
                        </group>
                    </group>

                    <group string="Sample JSON Payload (for Submit/Update)">
                        <field name="sample_payload" widget="text" nolabel="1"/>
                    </group>

                    <group string="Usage Guide">
                        <div class="alert alert-info">
                            <h4>📝 How to Use API</h4>
                            <ul>
                                <li><strong>Create Survey Response:</strong>
                                    <ul>
                                        <li>Method: <code>POST</code></li>
                                        <li>Copy Submit API Endpoint above</li>
                                        <li>Use Sample JSON Payload as request body</li>
                                        <li>Returns: <code>user_input_id</code> for future updates</li>
                                    </ul>
                                </li>
                                <li><strong>Get Participations (Find user_input_id):</strong>
                                    <ul>
                                        <li>Method: <code>GET</code></li>
                                        <li>Returns all participations with <code>user_input_id</code></li>
                                        <li>Optional filters:
                                            <ul>
                                                <li><code>?email=test@example.com</code> - Filter by email field</li>
                                                <li><code>?partner_id=123</code> - Filter by partner</li>
                                                <li><code>?question_74=abc@gmail.com</code> - Filter by answer to question 74</li>
                                                <li>Can combine multiple: <code>?question_74=John&amp;question_75=Developer</code></li>
                                            </ul>
                                        </li>
                                        <li>Use returned <code>user_input_id</code> for updates</li>
                                    </ul>
                                </li>
                                <li><strong>Update Survey Response:</strong>
                                    <ul>
                                        <li>Method: <code>PUT</code></li>
                                        <li>Replace <code>&lt;user_input_id&gt;</code> with actual ID from submit or participations</li>
                                        <li>Use same JSON payload format</li>
                                    </ul>
                                </li>
                                <li><strong>Get Survey Info:</strong>
                                    <ul>
                                        <li>Method: <code>GET</code></li>
                                        <li>Returns survey structure and questions</li>
                                    </ul>
                                </li>
                                <li><strong>Note:</strong> Add <code>?db=odoo18-isdtest</code> to all endpoints</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Survey API Helper Action -->
    <record id="action_survey_api_helper" model="ir.actions.act_window">
        <field name="name">API Helper</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_survey_api_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_survey_api_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No surveys found
            </p>
            <p>
                Create surveys first to use API Helper.
            </p>
        </field>
    </record>

</odoo>
